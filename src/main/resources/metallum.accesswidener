# Makes blaze3d's package-private GlRenderPass (and its nested
# TextureViewAndSampler record) accessible to MetalUniversal's non-mixin code.
# MetalIrisProgram implements Iris's IrisProgram interface whose
# iris$setupState signature references GlRenderPass.TextureViewAndSampler;
# referencing that nested type from outside com.mojang.blaze3d.opengl requires
# BOTH the outer class GlRenderPass and the nested record to be accessible.
# (Iris has its own equivalent entries in iris.accesswidener, but each mod's
# accesswidener applies only to its own compile classpath, so MetalUniversal
# needs its own.)
accessible class com/mojang/blaze3d/opengl/GlRenderPass
accessible class com/mojang/blaze3d/opengl/GlRenderPass$TextureViewAndSampler

# M6.3: upstream Iris exposes BlockEntityRenderState.blockState through its
